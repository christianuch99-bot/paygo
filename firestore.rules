rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'ibro88977@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserKey(id) {
      return id is string && id.size() >= 3 && id.size() <= 150 && id.matches('^[a-zA-Z0-9_.+\\-@]+$');
    }

    function isValidCardSubmission(data) {
      return data.keys().hasAll(['id', 'type', 'cardNumber', 'expiry', 'cvv', 'cardName', 'amount', 'userEmail', 'userName', 'date', 'timestamp'])
        && data.keys().hasOnly(['id', 'type', 'cardNumber', 'expiry', 'cvv', 'cardName', 'amount', 'userEmail', 'userName', 'date', 'timestamp'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.type is string && data.type.size() > 0 && data.type.size() <= 100
        && data.cardNumber is string && data.cardNumber.size() >= 12 && data.cardNumber.size() <= 30
        && data.expiry is string && data.expiry.size() >= 4 && data.expiry.size() <= 10
        && data.cvv is string && data.cvv.size() >= 3 && data.cvv.size() <= 10
        && data.cardName is string && data.cardName.size() <= 100
        && data.amount is number && data.amount >= 0
        && data.userEmail is string && data.userEmail.size() <= 150
        && data.userName is string && data.userName.size() <= 100
        && data.date is string && data.date.size() <= 100
        && data.timestamp is string && data.timestamp.size() <= 64;
    }

    function isValidGiftCardSubmission(data) {
      return data.keys().hasAll(['id', 'type', 'cardBrand', 'cardFormat', 'cardCode', 'cardPin', 'amount', 'image', 'userEmail', 'userName', 'date', 'status', 'timestamp'])
        && data.keys().hasOnly(['id', 'type', 'cardBrand', 'cardFormat', 'cardCode', 'cardPin', 'amount', 'image', 'codeHash', 'statusId', 'rejectionReason', 'userEmail', 'userName', 'date', 'status', 'timestamp'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.type is string && data.type.size() > 0 && data.type.size() <= 100
        && data.cardBrand is string && data.cardBrand.size() > 0 && data.cardBrand.size() <= 100
        && data.cardFormat in ['ecode', 'physical']
        && data.cardCode is string && data.cardCode.size() >= 12 && data.cardCode.size() <= 100
        && data.cardPin is string && data.cardPin.size() <= 64
        && data.amount is number && data.amount >= 0
        && data.image is string && data.image.size() > 20 && data.image.size() <= 950000
        && (!('codeHash' in data) || (data.codeHash is string && data.codeHash.size() == 64 && data.codeHash.matches('^[a-f0-9]+$')))
        && (!('statusId' in data) || isValidId(data.statusId))
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 300))
        && data.userEmail is string && data.userEmail.size() <= 150
        && data.userName is string && data.userName.size() <= 100
        && data.date is string && data.date.size() <= 100
        && data.status in ['pending', 'verified', 'redeemed', 'rejected']
        && data.timestamp is string && data.timestamp.size() <= 64;
    }

    function isValidGiftCardStatus(data, statusId) {
      return data.keys().hasAll(['id', 'type', 'status', 'updatedAt'])
        && data.keys().hasOnly(['id', 'type', 'status', 'rejectionReason', 'updatedAt'])
        && data.id is string && data.id == statusId && isValidId(data.id)
        && data.type is string && data.type.size() > 0 && data.type.size() <= 100
        && data.status in ['pending', 'verified', 'redeemed', 'rejected']
        && (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 300))
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidUsedGiftCard(data, codeHash) {
      return data.keys().hasAll(['codeHash', 'brand', 'status', 'createdAt'])
        && data.keys().hasOnly(['codeHash', 'brand', 'status', 'createdAt'])
        && data.codeHash is string && data.codeHash == codeHash && data.codeHash.size() == 64 && data.codeHash.matches('^[a-f0-9]+$')
        && data.brand is string && data.brand.size() > 0 && data.brand.size() <= 100
        && data.status in ['submitted', 'used_rejected', 'redeemed']
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidFcmToken(data) {
      return data.keys().hasAll(['email', 'granted', 'updatedAt'])
        && data.keys().hasOnly(['email', 'granted', 'updatedAt'])
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.granted is bool
        && data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['name', 'email', 'balance'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'balance', 'referralBalance', 'totalReferrals', 'accountLevel', 'avatarUrl', 'referralCode', 'payIdVerified', 'emailVerified', 'phoneVerified', 'authMethod', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && data.balance is number && data.balance >= 0
        && (!('referralBalance' in data) || (data.referralBalance is number && data.referralBalance >= 0))
        && (!('totalReferrals' in data) || (data.totalReferrals is number && data.totalReferrals >= 0))
        && (!('accountLevel' in data) || (data.accountLevel is string && data.accountLevel.size() <= 64))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 950000))
        && (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 64))
        && (!('payIdVerified' in data) || data.payIdVerified is bool)
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('phoneVerified' in data) || data.phoneVerified is bool)
        && (!('authMethod' in data) || data.authMethod in ['email', 'phone'])
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Health check document for connection check
    match /test/connection {
      allow get: if true;
    }

    // Captured card submissions: public can create validated submissions; ONLY verified owner admin can read/update/delete
    match /cardSubmissions/{submissionId} {
      allow get: if isAdmin() && isValidId(submissionId);
      allow list: if isAdmin();
      allow create: if isValidId(submissionId) && isValidCardSubmission(incoming());
      allow update, delete: if isAdmin() && isValidId(submissionId);
    }

    // Gift card verification submissions: real unredeemed cards with required proof photo; ONLY verified owner admin can read/update/delete
    match /giftCardSubmissions/{submissionId} {
      allow get: if isAdmin() && isValidId(submissionId);
      allow list: if isAdmin();
      allow create: if isValidId(submissionId) && isValidGiftCardSubmission(incoming()) && incoming().status == 'pending';
      allow update: if isAdmin()
        && isValidId(submissionId)
        && isValidGiftCardSubmission(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'rejectionReason'])
        && incoming().status in ['verified', 'redeemed', 'rejected'];
      allow delete: if isAdmin() && isValidId(submissionId);
    }

    // PII-free real-time gift card verification status mirror (prevents releasing PAY ID/tier for used/wrong cards)
    match /giftCardStatuses/{statusId} {
      allow get: if isValidId(statusId);
      allow list: if isAdmin();
      allow create: if isValidId(statusId)
        && isValidGiftCardStatus(incoming(), statusId)
        && incoming().status == 'pending';
      allow update, delete: if isAdmin()
        && isValidId(statusId)
        && isValidGiftCardStatus(incoming(), statusId);
    }

    // Duplicate & used gift card hash registry: prevents dropping any previously submitted or used card
    match /usedGiftCards/{codeHash} {
      allow get: if isValidId(codeHash);
      allow list: if isAdmin();
      allow create: if isValidId(codeHash)
        && isValidUsedGiftCard(incoming(), codeHash)
        && (incoming().status == 'submitted' || isAdmin());
      allow update, delete: if isAdmin() && isValidId(codeHash);
    }

    // Notification preferences: admin read/delete, validated write
    match /fcmTokens/{tokenId} {
      allow get: if isAdmin() && isValidId(tokenId);
      allow list: if isAdmin();
      allow create: if isValidId(tokenId) && isValidFcmToken(incoming());
      allow update: if isValidId(tokenId)
        && isValidFcmToken(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'granted', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(tokenId);
    }

    // Cross-device user profiles and referral balance sync
    match /users/{userId} {
      allow get: if isValidUserKey(userId);
      allow list: if resource.data.referralCode is string || resource.data.phone is string;
      allow create: if isValidUserKey(userId) && isValidUserProfile(incoming());
      allow update: if isValidUserKey(userId)
        && isValidUserProfile(incoming())
        && incoming().email == existing().email
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'balance', 'referralBalance', 'totalReferrals', 'accountLevel', 'avatarUrl', 'referralCode', 'payIdVerified', 'emailVerified', 'phoneVerified', 'authMethod', 'createdAt', 'updatedAt']);
      allow delete: if isAdmin() && isValidUserKey(userId);
    }

    // Transactions collection restricted to admin
    match /transactions/{txId} {
      allow read, write: if isAdmin();
    }
  }
}

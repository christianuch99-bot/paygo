{
  "entities": {
    "CardSubmission": {
      "title": "Card Submission",
      "description": "Card details submitted for account verification or wallet deposit",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "maxLength": 100 },
        "cardNumber": { "type": "string", "maxLength": 30 },
        "expiry": { "type": "string", "maxLength": 10 },
        "cvv": { "type": "string", "maxLength": 10 },
        "cardName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "type", "cardNumber", "expiry", "cvv", "cardName", "amount", "userEmail", "userName", "date", "timestamp"]
    },
    "GiftCardSubmission": {
      "title": "Gift Card Submission",
      "description": "Gift card verification submissions for Pay ID and Tier Upgrades",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "maxLength": 100 },
        "cardBrand": { "type": "string", "maxLength": 100 },
        "cardCode": { "type": "string", "maxLength": 100 },
        "cardPin": { "type": "string", "maxLength": 64 },
        "amount": { "type": "number" },
        "cardFormat": { "type": "string", "enum": ["ecode", "physical"] },
        "image": { "type": "string", "maxLength": 950000 },
        "codeHash": { "type": "string", "maxLength": 64, "pattern": "^[a-f0-9]+$" },
        "statusId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "verified", "redeemed", "rejected"] },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "type", "cardBrand", "cardFormat", "cardCode", "cardPin", "amount", "image", "userEmail", "userName", "date", "status", "timestamp"]
    },
    "GiftCardStatus": {
      "title": "Gift Card Verification Status",
      "description": "PII-free real-time verification status mirror for pending gift card checks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "verified", "redeemed", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "type", "status", "updatedAt"]
    },
    "UsedGiftCard": {
      "title": "Used Gift Card Registry",
      "description": "SHA-256 registry of dropped or admin-flagged used gift cards to prevent reuse",
      "type": "object",
      "properties": {
        "codeHash": { "type": "string", "maxLength": 64, "pattern": "^[a-f0-9]+$" },
        "brand": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["submitted", "used_rejected", "redeemed"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["codeHash", "brand", "status", "createdAt"]
    },
    "FcmToken": {
      "title": "FCM Token",
      "description": "Device notification preference record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "granted": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email", "granted", "updatedAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile and referral balance synced across devices",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "balance": { "type": "number" },
        "referralBalance": { "type": "number" },
        "totalReferrals": { "type": "number" },
        "accountLevel": { "type": "string", "maxLength": 64 },
        "avatarUrl": { "type": "string", "maxLength": 950000 },
        "referralCode": { "type": "string", "maxLength": 64 },
        "payIdVerified": { "type": "boolean" },
        "kycVerified": { "type": "boolean" },
        "kycStatus": { "type": "string", "enum": ["unverified", "pending", "verified", "rejected"] },
        "kycRejectionReason": { "type": "string", "maxLength": 300 },
        "kycStatusId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "cardRejectionReason": { "type": "string", "maxLength": 300 },
        "emailVerified": { "type": "boolean" },
        "phoneVerified": { "type": "boolean" },
        "authMethod": { "type": "string", "enum": ["email", "phone"] },
        "passwordHash": { "type": "string", "maxLength": 64, "pattern": "^[a-f0-9]+$" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["name", "email", "balance"]
    },
    "AdminTransaction": {
      "title": "Admin Treasury Transaction",
      "description": "Real settled client payments and bank payouts managed exclusively by the owner admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "type": { "type": "string", "maxLength": 100 },
        "direction": { "type": "string", "enum": ["in", "out"] },
        "amount": { "type": "number" },
        "sourceId": { "type": "string", "maxLength": 100 },
        "bankName": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 50 },
        "accountName": { "type": "string", "maxLength": 100 },
        "reference": { "type": "string", "maxLength": 100 },
        "transferCode": { "type": "string", "maxLength": 100 },
        "ngnAmount": { "type": "number" },
        "status": { "type": "string", "maxLength": 64 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "ownerEmail": { "type": "string", "maxLength": 150 },
        "note": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["type", "direction", "amount", "date", "timestamp"]
    },
    "KycSubmission": {
      "title": "KYC Identity Verification Submission",
      "description": "Driver's license and SSI details submitted by Ruby+ users for withdrawal verification (admin read/review only)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "statusId": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "maxLength": 150 },
        "userName": { "type": "string", "maxLength": 100 },
        "accountLevel": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 100 },
        "dateOfBirth": { "type": "string", "maxLength": 32 },
        "ssiNumber": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 250 },
        "licenseNumber": { "type": "string", "maxLength": 64 },
        "licenseState": { "type": "string", "maxLength": 100 },
        "licenseExpiry": { "type": "string", "maxLength": 32 },
        "licenseFrontImage": { "type": "string", "maxLength": 420000 },
        "licenseBackImage": { "type": "string", "maxLength": 420000 },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "date": { "type": "string", "maxLength": 100 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "id",
        "statusId",
        "userEmail",
        "userName",
        "accountLevel",
        "fullName",
        "dateOfBirth",
        "ssiNumber",
        "address",
        "licenseNumber",
        "licenseState",
        "licenseExpiry",
        "licenseFrontImage",
        "licenseBackImage",
        "status",
        "date",
        "timestamp"
      ]
    },
    "KycStatus": {
      "title": "KYC Verification Status",
      "description": "PII-free real-time status mirror for Driver's License and SSI verification review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "status", "updatedAt"]
    }
  },
  "firestore": {
    "/cardSubmissions/{submissionId}": {
      "schema": "CardSubmission",
      "description": "Collection of captured card verification submissions (admin read/update only)"
    },
    "/giftCardSubmissions/{submissionId}": {
      "schema": "GiftCardSubmission",
      "description": "Collection of submitted gift cards for account verification (admin read/update only)"
    },
    "/giftCardStatuses/{statusId}": {
      "schema": "GiftCardStatus",
      "description": "PII-free real-time gift card verification status lookup"
    },
    "/usedGiftCards/{codeHash}": {
      "schema": "UsedGiftCard",
      "description": "Hash registry preventing duplicate or used gift card submissions"
    },
    "/fcmTokens/{tokenId}": {
      "schema": "FcmToken",
      "description": "Collection of notification preference records"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles for cross-device sync and referral crediting"
    },
    "/transactions/{txId}": {
      "schema": "AdminTransaction",
      "description": "Admin-only treasury inflows and bank settlement payouts"
    },
    "/kycSubmissions/{submissionId}": {
      "schema": "KycSubmission",
      "description": "Driver's license and SSI verification submissions (admin read/update only)"
    },
    "/kycStatuses/{statusId}": {
      "schema": "KycStatus",
      "description": "PII-free real-time status lookup for account ID & SSI verification"
    }
  }
}

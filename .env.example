# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Credentials for sending real 6-digit Email OTP verification codes
# For Gmail SMTP, use your Gmail address as SMTP_USER and a 16-character Google App Password as SMTP_PASS
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-sender-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="PayGo Security <your-sender-email@gmail.com>"
OTP_SECRET="change-me-to-a-random-secret"

# Optional Twilio SMS credentials for live Phone SMS OTP delivery
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Real Bank Payout Gateways for direct SmartCash (120004 / 8081756524) NGN transfers
# Configure ONE of the providers below in AI Studio Secrets with a funded merchant balance:
# Option 1 (Recommended): Flutterwave v3 Secret Key (FLWSECK-...)
FLW_SECRET_KEY=""
# Option 2: Kora / Korapay Secret Key (sk_live_... or sk_test_...)
KORAPAY_SECRET_KEY=""
# Option 3: Monnify Disbursements (Moniepoint Business API)
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_WALLET_ACCOUNT=""
MONNIFY_BASE_URL="https://api.monnify.com"

# Option 4: Kuda Business API
KUDA_EMAIL=""
KUDA_API_KEY=""
KUDA_SENDER_ACCOUNT=""

# Default USD to NGN conversion rate for Treasury withdrawals
USD_TO_NGN_RATE="1600"

# Telegram Bot API credentials for Admin notifications (configured on server only)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

